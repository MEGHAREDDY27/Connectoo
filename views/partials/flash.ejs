<% if (typeof session !== 'undefined' && session && session.flash) { %>
  <div id="flash-message" role="alert" class="max-w-5xl mx-auto mt-4 px-4">
    <div class="rounded-lg px-4 py-3 text-sm font-medium border <%= session.flash.type === 'success' ? 'bg-emerald-500/15 border-emerald-500 text-emerald-300' : 'bg-red-500/15 border-red-500 text-red-300' %>">
      <%= session.flash.message %>
    </div>
  </div>
  <% delete session.flash; %>
<% } %>

        <a href="/report" id="nav-report" class="px-3 py-1.5 rounded-md text-slate-700 dark:text-slate-300 hover:text-pink-700 dark:hover:text-white hover:bg-pink-100 dark:hover:bg-slate-800">Report Issue</a>

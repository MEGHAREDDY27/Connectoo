      <% } %>
      <% if (user && user.role === 'authority') { %>
        <a href="/official/dashboard" id="nav-dashboard" class="px-3 py-1.5 rounded-md text-slate-300 hover:text-white hover:bg-slate-800">Dashboard</a>
      <% } %>
      <% if (user && user.role === 'field_worker') { %>
        <a href="/field/dashboard" id="nav-field-tasks" class="px-3 py-1.5 rounded-md text-slate-300 hover:text-white hover:bg-slate-800">My tasks</a>
      <% } %>
    </div>


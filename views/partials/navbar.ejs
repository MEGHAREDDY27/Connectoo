<nav id="navbar" class="sticky top-0 z-50 bg-pink-50/95 dark:bg-slate-900/95 backdrop-blur border-b border-pink-200 dark:border-slate-700">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between gap-4">

<%- include('../partials/head') %>
<body class="bg-pink-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 min-h-screen font-sans">
<%- include('../partials/navbar') %>

<main class="max-w-md mx-auto px-4 py-12">
  <div class="bg-white dark:bg-slate-800 border border-pink-200 dark:border-slate-700 rounded-xl p-8">
    <h1 class="text-2xl font-bold">Create your account</h1>
    <p class="text-sm text-slate-400 mt-1">Citizen accounts can report, hype and comment.</p>
    <form id="register-form" action="/register" method="POST" class="mt-6 space-y-4">
      <div>
        <label for="register-username" class="block text-sm font-medium text-slate-300 mb-1">Username</label>
        <input id="register-username" name="username" type="text" required minlength="3" maxlength="30" value="<%= form.username || '' %>" autocomplete="username" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500">
      </div>
      <div>
        <label for="register-email" class="block text-sm font-medium text-slate-300 mb-1">Email</label>
        <input id="register-email" name="email" type="email" required value="<%= form.email || '' %>" autocomplete="email" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500">
      </div>
      <div>
        <label for="register-password" class="block text-sm font-medium text-slate-300 mb-1">Password (min 6 characters)</label>
        <input id="register-password" name="password" type="password" required minlength="6" autocomplete="new-password" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500">
      </div>
      <button id="register-submit" type="submit" class="w-full py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 font-semibold">Register</button>
    </form>
    <p class="text-sm text-slate-400 mt-4">Already registered? <a id="register-login-link" href="/login" class="text-blue-400 hover:underline">Sign in</a></p>
  </div>
</main>

<script src="/js/main.js"></script>
</body>
</html>

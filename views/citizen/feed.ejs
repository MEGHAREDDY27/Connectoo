<%- include('../partials/head') %>
<body class="bg-pink-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 min-h-screen font-sans">
<%- include('../partials/navbar') %>

<header class="border-b border-pink-200 dark:border-slate-700 bg-gradient-to-b from-pink-100 to-pink-50 dark:from-slate-800/60 dark:to-slate-900">
  <div class="max-w-5xl mx-auto px-4 py-12 text-center">
    <h1 id="hero-title" class="text-4xl font-extrabold tracking-tight">Your City. Your Voice.</h1>
    <p id="hero-subtitle" class="mt-2 text-slate-600 dark:text-slate-400">Hype what matters. Watch your ward improve.</p>
  </div>
</header>

<main class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex items-baseline justify-between mb-4">
    <h2 class="text-xl font-bold">Trending in your city</h2>
    <span id="report-total" class="text-sm text-slate-400"><%= total %> report<%= total === 1 ? '' : 's' %></span>
  </div>

  <div id="feed-container" class="grid gap-4 md:grid-cols-2">
    <% if (reports.length === 0) { %>
      <p id="feed-empty" class="md:col-span-2 text-center text-slate-400 py-12">No reports yet. Be the first to speak up.</p>
    <% } %>
    <% reports.forEach(function (r) { %>
      <a href="/reports/<%= r.id %>" id="report-card-<%= r.id %>" class="report-card block bg-white dark:bg-slate-800 border border-pink-200 dark:border-slate-700 rounded-xl overflow-hidden hover:-translate-y-0.5 hover:shadow-xl hover:shadow-pink-500/10 transition">
        <% if (r.image_path) { %>
          <img src="<%= r.image_path %>" alt="" loading="lazy" class="w-full h-40 object-cover border-b border-slate-700">
        <% } %>
        <div class="p-4">
          <div class="flex items-center justify-between">
            <span id="status-badge-<%= r.id %>" class="text-xs font-bold uppercase tracking-wide px-3 py-0.5 rounded-full <%= statusBadge(r.status) %>"><%= r.status %></span>
            <span class="text-xs text-slate-400"><%= formatDate(r.created_at) %></span>
          </div>
          <h3 class="mt-2 text-lg font-bold"><%= r.title %></h3>
          <p class="text-sm text-slate-400 mt-0.5"><%= r.ward %> · <%= r.location %></p>
          <p class="text-sm text-slate-300 mt-2"><%= r.description.length > 140 ? r.description.slice(0, 140) + '…' : r.description %></p>
          <div class="mt-3 flex items-center justify-between text-sm text-slate-400">
            <span class="font-semibold text-blue-300">▲ <span id="feed-hype-<%= r.id %>"><%= r.hype_count %></span></span>
            <span>by <%= r.author %></span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>

  <% if (totalPages > 1) { %>
    <nav id="pagination" class="flex items-center justify-center gap-3 mt-8 text-sm" aria-label="Pagination">
      <% if (page > 1) { %>
        <a id="page-prev" href="/?page=<%= page - 1 %>" class="px-4 py-2 rounded-md border border-slate-600 hover:border-blue-500">← Previous</a>
      <% } %>
      <span id="page-indicator" class="text-slate-400">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a id="page-next" href="/?page=<%= page + 1 %>" class="px-4 py-2 rounded-md border border-slate-600 hover:border-blue-500">Next →</a>
      <% } %>
    </nav>
  <% } %>
</main>

<script src="/js/main.js"></script>
</body>
</html>
